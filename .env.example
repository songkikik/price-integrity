# ===========================================
# price-integrity 환경 변수 템플릿
# 실제 값은 .env로 복사 후 입력 (커밋 금지)
# ===========================================

# --- ClickHouse ---
# v0.1: Docker Compose 로컬 (localhost). k3s 이후 클러스터 내부 주소로 변경.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=price_integrity

# --- Kafka (v0.3) ---
# 호스트에서 producer/consumer를 실행 → advertised listener와 동일하게 localhost.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=crypto.ticker.v1
# consumer group id. 이 값 기준으로 오프셋이 브로커에 저장됨 → replay 시 리셋 대상.
KAFKA_CONSUMER_GROUP=ch-loader

# --- 알림 ---
# Slack 개인 워크스페이스(gihun-sideprojects) > #alerts-price-integrity 채널 webhook
SLACK_WEBHOOK_URL=

# --- Airflow (k3s 배포 시 사용) ---
AIRFLOW_FERNET_KEY=

# --- 운영 ---
TZ=Asia/Seoul