# ===========================================
# price-integrity 환경 변수 템플릿
# 실제 값은 .env 로 복사 후 입력 (커밋 금지)
# ===========================================

# --- Postgres (로컬 k3s 내부 서비스) ---
POSTGRES_HOST=postgres.price-integrity.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=price_admin
POSTGRES_PASSWORD=
POSTGRES_DB=price_warehouse

# --- 외부 API 키 ---
# 한국은행 ECOS API (https://ecos.bok.or.kr/api/)
ECOS_API_KEY=

# Yahoo Finance: API 키 불필요 (yfinance 라이브러리 사용)
# Upbit / Bithumb: public ticker 는 키 불필요
# Binance / Coinbase: public ticker 는 키 불필요
# Stooq: 키 불필요
# Naver Finance: 스크래핑 (User-Agent 헤더 지정)

# --- 알림 채널 ---
# Discord Webhook (라우팅별 분리)
DISCORD_WEBHOOK_LOW=
DISCORD_WEBHOOK_HIGH=

# --- 운영 ---
# Airflow Fernet Key (helm install 시 자동 생성하거나 수동 지정)
AIRFLOW_FERNET_KEY=

# 로컬 개발용 timezone
TZ=Asia/Seoul